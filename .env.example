# Copy to `.env` (never commit `.env`).
# Example local Docker:
# DATABASE_URL="postgresql://finaceiag:finaceiag@localhost:5432/finaceiag?schema=public"
#
# Example Railway / hosted Postgres (keep connection_limit=1 for Vercel serverless):
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=1&pool_timeout=20"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=1"

# Go Gin API (Railway) — required for all accounting/auth data routes.
# next.config rewrites /api/* (except /api/realtime and /api/health) to this URL.
# Production (Vercel + local against live API):
GO_API_URL="https://api-production-b0c8d.up.railway.app"
# Users and roles are created in IAG Admin, then read by this app.
# NEXT_PUBLIC_ADMIN_URL="http://127.0.0.1:3090"
# Local Go only: start backend (`npm run api:dev`) then use:
# GO_API_URL="http://127.0.0.1:8080"
#
# Next proxy verifies JWTs — use the SAME JWT_SECRET as backend/.env.
# Business data is stored in Postgres only (entity_records, app_settings, ledger).
# Schema migrations: backend/migrations applied by the Go API on boot.

# Railway Redis (settings cache + KV + realtime SSE fan-out)
# REDIS_URL="redis://default:PASSWORD@HOST:PORT"
# Local Docker: docker compose up -d redis
REDIS_URL=""

# Optional Kafka for realtime messaging to external consumers.
# Local: docker compose up -d redpanda  →  KAFKA_BROKERS="localhost:19092"
# Railway (same project): KAFKA_BROKERS="${{Kafka.RAILWAY_PRIVATE_DOMAIN}}:9092"
# KAFKA_TOPIC="financeiag.realtime"
# KAFKA_CLIENT_ID="financeiag"
# Optional SASL (some Railway Kafka templates):
# KAFKA_SASL_USERNAME="kafka"
# KAFKA_SASL_PASSWORD="..."
# KAFKA_SASL_MECHANISM="plain"
# KAFKA_SSL=false
KAFKA_BROKERS=""
KAFKA_TOPIC="financeiag.realtime"

# Outbound email on Vercel (Next /api/email/* — not proxied to Railway).
# Request alerts call /api/email/send on Vercel using SMTP.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=support@yourdomain.com
# SMTP_PASSWORD=app-password
# SMTP_FROM_EMAIL=support@yourdomain.com
# SMTP_FROM_NAME=FinanceIAG
# SMTP_USE_TLS=true

# Outbound SMS on Vercel (Next /api/sms/send — EgoSMS, not Twilio).
# Prefer Settings → SMS in the app; these env vars override Settings when set.
# EGO_SMS_USERNAME=your-egosms-username
# EGO_SMS_PASSWORD=your-egosms-password
# EGO_SMS_SENDER=IAGFinance
# Kill switch — unset means enabled; set false/0/no/off to make sends return 503.
# EGO_SMS_ENABLED=true
# Endpoint. A path ending in /plain uses the GET API (one request per number);
# anything else uses the JSON batch API. Defaults to the JSON endpoint.
# EGO_SMS_API_URL=https://www.egosms.co/api/v1/json/

# Toast + bell notifications for live SSE/WebSocket/Kafka record updates
# Defaults ON — set either to false to silence toast/bell only (sync still runs).
# Lists/tables soft-refresh in the background (Gmail-style); toasts only when the tab is hidden.
REALTIME_NOTIFICATIONS=true
NEXT_PUBLIC_REALTIME_NOTIFICATIONS=true
# Custom server exposes WebSocket at /api/ws (SSE fallback: /api/realtime)
# Server ActivityLog (Documents → History) records all CRUD from API writes.

# API auth (HS256 JWT — required in production)
# Generate: openssl rand -hex 32
# MUST also be set in Vercel Project → Settings → Environment Variables
JWT_SECRET=""
JWT_EXPIRY=12h
# Longer token when “Keep me signed in” is checked (cookie Max-Age matches)
JWT_EXPIRY_KEEP=30d
# Login / API rate limit (attempts per IP per minute). Login uses ~1/3 of this (min 10).
RATE_LIMIT_PER_MIN=600
# AUTH_REQUIRED=true|false  (default: on when JWT_SECRET is set; off without a secret)
# AUTH_REQUIRED=true
# Optional machine auth for scripts/CI (bypasses JWT; treated as Administrator)
# API_KEY=""
# Must match Railway Go API_KEY. Standalone tools use it server-side so
# Activity logs can show every user (page views + field before/after).
# Must also be set in Vercel → Environment Variables for production.
# Allow /api/auth/seed (admin-only). Default off in production.
# ALLOW_AUTH_SEED=false

# FastAPI ML/AI service (Railway) — proxied by Next at /api/ml/*.
ML_API_URL="https://ml-production-fcf5.up.railway.app"
# Optional shared key (also set on the ML process as ML_API_KEY / API_KEY)
# ML_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# IAG platform wiring
# ─────────────────────────────────────────────────────────────────────────────
# Domain data for this app is served by: iag-mes (batch records, downtime,
# work centres) and iag-production (orders, roast batches, packaging runs,
# plans, yield). Both audiences — iag.mes and iag.production — must be on the
# token.
# Leave these unset and the app keeps using GO_API_URL (or local).
# IAG_GATEWAY_ORIGIN="https://iag-api-gateway-production.up.railway.app"
# IAG_ADAPTER_ENABLED=true
# IAG_UNMAPPED_MODE=passthrough
# IAG_OAUTH_CLIENT_ID="iag-platform"
# IAG_OAUTH_CLIENT_SECRET=""
# IAG_MES_PREFIX="/api/v1/mes"
# IAG_PRODUCTION_PREFIX="/api/v1/production"
# GO_API_KEY=""

# Master switch. false = wire to a backend; unset/true = standalone (browser
# only, localStorage). This was a hardcoded `true` in the source before; it is
# now read from the environment like every other IAG app. NEXT_PUBLIC_* is
# inlined at build time, so change it and redeploy.
# NEXT_PUBLIC_FRONTEND_ONLY=false
